<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        var selectedWarehouseId = $('#selectedWarehouseId').val();
        var selectedRackId = $('#selectedRackId').val();

        // Load Warehouses
        $.ajax({
            url: '@Url.Action("GetWarehouses", "Master")',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var select = $('#stockTypeFilter');
                select.empty();

                $.each(data, function (index, item) {
                    select.append('<option value="' + item.id + '">' + item.name + '</option>');
                });

                if (selectedWarehouseId) {
                    // select saved warehouse
                    select.val(selectedWarehouseId).trigger('change');
                } else if (data.length > 0) {
                    // default first
                    select.val(data[0].id).trigger('change');
                }
            }
        });


        $('#stockTypeFilter').change(function () {
            var warehouseId = $(this).val();
            var rackSelect = $('#rackFilter');
            rackSelect.empty().append('<option>Loading...</option>'); 

            if (warehouseId) {
                $.ajax({
                    url: '@Url.Action("GetRacks", "Master")',
                    type: 'GET',
                    data: { warehouseId: warehouseId },
                    dataType: 'json',
                    success: function (data) {
                        rackSelect.empty();
                        if (data.length > 0) {
                            $.each(data, function (index, item) {
                                rackSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });

                            //rackSelect.val(data[0].id); 
                            if (selectedRackId) {
                                rackSelect.val(selectedRackId);
                            } else {
                                rackSelect.val(data[0].id); // fallback first rack
                            }
                        } else {
                            rackSelect.append('<option value="">No racks available</option>');
                        }
                    },
                    error: function () {
                        rackSelect.empty().append('<option value="">Error loading racks</option>');
                    }
                });
            } else {
                rackSelect.empty().append('<option value="">Select Rack</option>');
            }
        });

    });
</script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $('#editProductForm').submit(function(e){
        e.preventDefault();

        var $submitBtn = $('#submitBtn');
        $submitBtn.prop('disabled', false);

        var formData = $(this).serialize();

        $.ajax({
            url: '/Master/EditProduct',
            type: 'POST',
            data: formData,
            success: function(response){
                if(response.success){
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: 'Product updated successfully!'
                     }).then(() => {
                        // ✅ Redirect after success
                        window.location.href = response.redirectUrl;
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: response.message
                    });
                    $submitBtn.prop('disabled', false);
                }
            },
            error: function(){
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong!'
                });
                $submitBtn.prop('disabled', false);
            }
        });
    });
</script>



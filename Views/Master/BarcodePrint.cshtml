        @* Start This Code For Scan or Enter SKUName & Show The  ProductName or SelectProduct & Show SKUName *@

        <script>
            $(document).ready(function () {
                var $productInput = $('#product');
                var $productList = $('#productList');
                var $productId = $('#FkProductId');
                var $skuInput = $('#sku');
                var $headerInput = $('#header');
                var selectedIndex = -1;

                // Update the preview section
                function updatePreview(headerText, skuText) {
                    if (headerText && skuText) {
                        $('#previewHeader').text(headerText);

                        JsBarcode("#previewBarcode", skuText, {
                            format: "CODE128",
                            lineColor: "#000",
                            width: 2,
                            height: 60,
                            displayValue: true
                        });

                        $('#barcodePreview').show();
                    } else {
                        $('#barcodePreview').hide();
                    }
                }

                // ProductName Input Autocomplete
                $productInput.on('input', function () {
                    var term = $(this).val().trim();
                    selectedIndex = -1;

                    if (term.length < 1) {
                        $productList.hide().empty();
                        return;
                    }

                    $.ajax({
                        url: '/Inventory/GetProducts',
                        type: 'GET',
                        dataType: 'json',
                        data: { term: term },
                        success: function (data) {
                            $productList.empty();
                            if (data.length === 0) {
                                $productList.hide();
                                return;
                            }

                            $.each(data, function (index, item) {
                                $productList.append(
                                    $('<li>').text(item.productName)
                                        .attr('data-id', item.id)
                                        .attr('data-sku', item.skuName)
                                        .on('click', function () {
                                            $productInput.val(item.productName);
                                            $skuInput.val(item.skuName); // show SKU
                                            $productId.val(item.id);
                                            $headerInput.val(item.productName);
                                            updatePreview(item.productName, item.skuName);
                                            $productList.hide().empty();
                                        })
                                );
                            });

                            $productList.show();
                        },
                        error: function () {
                            $productList.hide().empty();
                        }
                    });
                });

                $productInput.on('keydown', function (e) {
                    var items = $productList.find('li');
                    if ($productList.is(':visible')) {
                        if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            if (selectedIndex < items.length - 1) {
                                selectedIndex++;
                                highlightItem(items, selectedIndex);
                            }
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            if (selectedIndex > 0) {
                                selectedIndex--;
                                highlightItem(items, selectedIndex);
                            }
                        } else if (e.key === 'Enter') {
                            e.preventDefault();
                            if (selectedIndex >= 0 && selectedIndex < items.length) {
                                var selected = $(items[selectedIndex]);
                                $productInput.val(selected.text());
                                $productId.val(selected.data('id'));
                                $skuInput.val(selected.data('sku'));
                                $headerInput.val(selected.text());
                                updatePreview(selected.text(), selected.data('sku'));
                                $productList.hide().empty();
                            }
                        }
                    }
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#product, #productList').length) {
                        $productList.hide().empty();
                    }
                });

                // Handle SKU Input (Scan barcode)
                $skuInput.on('change', function () {
                    var sku = $(this).val().trim();
                    if (sku.length < 1) {
                        $productInput.val('');
                        $productId.val('');
                        $headerInput.val('');
                        updatePreview('', '');
                        return;
                    }

                    $.ajax({
                        url: '/Inventory/GetProductBySku',
                        type: 'GET',
                        data: { sku: sku },
                        success: function (data) {
                            if (data) {
                                $productInput.val(data.productName);
                                $productId.val(data.productId);
                                $headerInput.val(data.productName);
                                updatePreview(data.productName, sku);
                            } else {
                                $productInput.val('');
                                $productId.val('');
                                $headerInput.val('');
                                updatePreview('', '');
                            }
                        },
                        error: function () {
                            $productInput.val('');
                            $productId.val('');
                            $headerInput.val('');
                            updatePreview('', '');
                        }
                    });
                });

                $productInput.on('change', function () {
                    if ($(this).val().trim() === '') {
                        $productId.val('');
                        $skuInput.val('');
                        $headerInput.val('');
                        updatePreview('', '');
                    }
                });

                $headerInput.on('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        var headerText = $(this).val().trim();
                        var skuText = $skuInput.val().trim();
                        updatePreview(headerText, skuText);
                    }
                });

                function highlightItem(items, index) {
                    items.removeClass('highlighted');
                    $(items[index]).addClass('highlighted');
                }
            });
        </script>

        @* End This Code For Scan or Enter SKUName & Show The  ProductName or SelectProduct & Show SKUName *@


    </body>
</html>










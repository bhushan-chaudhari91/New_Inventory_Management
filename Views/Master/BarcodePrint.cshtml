        <script>
             $('#printLabelsBtn').on('click', function () {
            const quantity = parseInt($('#Quantity').val()) || 1;
            const header = $('#header').val().trim();
            const svgOriginal = document.getElementById("previewBarcode");

            if (!header || !svgOriginal || svgOriginal.innerHTML.trim() === "") {
                alert("Header or barcode is missing!");
                return;
            }

            const svgData = new XMLSerializer().serializeToString(svgOriginal);
            const svgBlob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });
            const imageUrl = URL.createObjectURL(svgBlob);

            // Determine label size
            let widthMM = 50;
            let heightMM = 25;
            let designType = 'small'; // default

            const labelSize = $('#labelSize').val();
            if (labelSize === 'custom') {
                widthMM = parseFloat($('#customWidth').val()) || 50;
                heightMM = parseFloat($('#customHeight').val()) || 25;
                designType = 'custom';
            } else {
                const [w, h] = labelSize.split('x');
                widthMM = parseFloat(w);
                heightMM = parseFloat(h);

                // Select design type based on height
                if (widthMM === 50 && heightMM === 25) {
                    designType = 'small';
                } else {
                    designType = 'large';
                }
            }

            const printWindow = window.open('', '', 'width=800,height=600');
            printWindow.document.write('<html><head><title>Print</title><style>');

            // Common styles
            printWindow.document.write(`
                @@media print {
                    @@page {
                        size: ${widthMM}mm ${heightMM}mm;
                        margin: 0;
                    }
                    body {
                        margin: 0;
                        padding: 0;
                        font-family: Arial, sans-serif;
                    }
                }
                body {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: start;
                }
            `);

            // Small label design (50x25mm)
            if (designType === 'small') {
                printWindow.document.write(`
                    .label {
                        width: ${widthMM}mm;
                        height: ${heightMM}mm;
                        margin: 0;
                        padding: 0;
                        box-sizing: border-box;
                        position: relative;
                        page-break-after: always;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                        text-align: center;
                    }
                    .label h3 {
                        font-size: 7pt;
                        font-weight: bold;
                        margin: 0 0 1mm 0;
                        white-space: nowrap;
                    }
                    .label img {
                        width: 42mm;
                        height: 14mm;
                        object-fit: contain;
                        display: block;
                    }
                `);
            }

            // Large label design (50x58, 101x88, etc.)
            else if (designType === 'large') {
                printWindow.document.write(`
                    .label {
                        width: ${widthMM}mm;
                        height: ${heightMM}mm;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        text-align: center;
                        page-break-after: always;
                        page-break-inside: avoid;
                        padding: 4mm;
                        box-sizing: border-box;
                    }
                    .label h3 {
                        font-size: 12pt;
                        margin: 0 0 3mm 0;
                    }
                    .label img {
                        width: 90%;
                        height: auto;
                    }
                `);
            }

            printWindow.document.write('</style></head><body>');

            for (let i = 0; i < quantity; i++) {
                printWindow.document.write(`
                    <div class="label">
                        <h3>${header}</h3>
                        <img src="${imageUrl}" />
                    </div>
                `);
            }

            printWindow.document.write('</body></html>');
            printWindow.document.close();

            printWindow.onload = function () {
                printWindow.focus();
                printWindow.print();
                setTimeout(() => {
                    printWindow.close();
                }, 1000);
            };
        });
        </script>




 @* Start this code for Auto Fectch Warehouse and RackNo and Data add In Table on 28/08/2025*@
<script>
    let serialNumber = 1;
    let productType = 1;
    let perBoxQty = 1;

    $(document).ready(function () {
        var $productInput = $('#product');
        var $productList = $('#productList');
        var $productId = $('#FkProductId');
        var $skuInput = $('#barcodeNo');
        var $warehouseDropdown = $('#warehouse');
        var $rackNoDropdown = $('#rackNo');
        var $availableQuantity = $('#availableQuantity');
        var $productQuantity = $('#productQuantity');
        var selectedIndex = -1;
        var warehouseQuantities = [];

        // Load rack numbers and update AvailableQuantity
        function loadRackNos(sku, warehouseId, quantities, callback) {
            warehouseQuantities = quantities || [];
            const currentRack = $rackNoDropdown.val();
            $rackNoDropdown.empty();

            if (!warehouseId || !sku || !warehouseQuantities) {
                $rackNoDropdown.append('<option value="">Select Warehouse First</option>');
                $availableQuantity.val('0');
                if (callback) callback();
                return;
            }

            // Filter racks excluding null, undefined, or empty rackNo
            const racksForWarehouse = [...new Set(warehouseQuantities
                .filter(q => q.warehouseId == parseInt(warehouseId) && q.totalQuantity > 0 && q.type == productType && q.rackNo && q.rackNo.trim() !== '')
                .map(q => q.rackNo))];

            if (racksForWarehouse.length === 0) {
                $rackNoDropdown.append('<option value="">No Racks Available</option>');
                // Calculate total quantity for the warehouse
                const totalWarehouseQty = warehouseQuantities
                    .filter(q => q.warehouseId == parseInt(warehouseId) && q.type == productType)
                    .reduce((sum, q) => sum + (q.totalQuantity || 0), 0);
                $availableQuantity.val(totalWarehouseQty > 0 ? totalWarehouseQty : '0');
            } else {
                // Populate rack options
                racksForWarehouse.forEach(rack => {
                    $rackNoDropdown.append(`<option value="${rack}">${rack}</option>`);
                });

                // Select the first available rack by default, or keep current rack if valid
                if (currentRack && racksForWarehouse.includes(currentRack)) {
                    $rackNoDropdown.val(currentRack);
                } else {
                    $rackNoDropdown.val(racksForWarehouse[0]); // Select first available rack
                }
                updateAvailableQuantity(warehouseId, $rackNoDropdown.val());
            }
            if (callback) callback();
        }

        // Update AvailableQuantity based on selected warehouse, rack, and type
        function updateAvailableQuantity(warehouseId, rackNo) {
            if (warehouseId && rackNo && warehouseQuantities) {
                const rackData = warehouseQuantities.find(
                    q => q.warehouseId == parseInt(warehouseId) && q.rackNo == rackNo && q.type == productType
                );
                $availableQuantity.val(rackData ? rackData.totalQuantity : '0');
            } else if (warehouseId && !rackNo && warehouseQuantities) {
                // Sum quantities for the warehouse
                const totalWarehouseQty = warehouseQuantities
                    .filter(q => q.warehouseId == parseInt(warehouseId) && q.type == productType)
                    .reduce((sum, q) => sum + (q.totalQuantity || 0), 0);
                $availableQuantity.val(totalWarehouseQty > 0 ? totalWarehouseQty : '0');
            } else {
                $availableQuantity.val('0');
            }
        }

        // Barcode input handling (Enter key or scan)
        $skuInput.on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const barcode = $(this).val().trim();
                if (barcode === '') return;

                $.ajax({
                    url: '/Inventory/GetProductByBarcodeInStockOut',
                    type: 'GET',
                    data: { sku: barcode },
                    success: function (data) {
                        if (data && data.productId && data.warehouseQuantities && data.warehouseQuantities.length > 0) {
                            $productInput.val(data.productName);
                            $productId.val(data.productId);
                            $skuInput.val(data.skuName);
                            $('#getStockInQuantity').val(data.stockInQuantity);

                            productType = data.type;
                            perBoxQty = data.perBoxQty;

                            const currentSelectedWarehouse = $warehouseDropdown.val();
                            let selectedWarehouseId = currentSelectedWarehouse;

                            // Filter warehouseQuantities by type and stock
                            const validWarehouses = [...new Set(data.warehouseQuantities
                                .filter(q => q.totalQuantity > 0 && q.type == productType)
                                .map(q => q.warehouseId))];

                            if (!currentSelectedWarehouse || !validWarehouses.includes(parseInt(currentSelectedWarehouse))) {
                                if (validWarehouses.length > 0) {
                                    selectedWarehouseId = validWarehouses[0];
                                    $warehouseDropdown.val(selectedWarehouseId).trigger('change');
                                } else {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: 'No Stock Available',
                                        text: `No available quantity for this barcode with type ${productType} in any warehouse.`,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'OK'
                                    });
                                    resetForm();
                                    return;
                                }
                            }

                            // Load racks and validate
                            loadRackNos(data.skuName, selectedWarehouseId, data.warehouseQuantities, function () {
                                const selectedRack = $rackNoDropdown.val();
                                if ($productId.val() && selectedWarehouseId && (selectedRack || $rackNoDropdown.find('option').length === 1)) {
                                    const rackHasStock = selectedRack ? warehouseQuantities.some(
                                        q => q.warehouseId == parseInt(selectedWarehouseId) && q.rackNo == selectedRack && q.totalQuantity > 0 && q.type == productType
                                    ) : true; // No racks case

                                    if (!rackHasStock) {
                                        Swal.fire({
                                            icon: 'warning',
                                            title: 'No Stock Available',
                                            text: `No available quantity for rack ${selectedRack} with type ${productType} in the selected warehouse.`,
                                            confirmButtonColor: '#3085d6',
                                            confirmButtonText: 'OK'
                                        });
                                        $availableQuantity.val('0');
                                        return;
                                    }
                                    updateAvailableQuantity(selectedWarehouseId, selectedRack);
                                    autoAddToTable();
                                } else {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: 'Incomplete Data',
                                        text: 'Please ensure a warehouse and rack are selected.',
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'OK'
                                    });
                                }
                            });

                            // Handle warehouse change
                            $warehouseDropdown.off('change.rack').on('change.rack', function () {
                                const newWarehouseId = $(this).val();
                                loadRackNos(data.skuName, newWarehouseId, warehouseQuantities);
                            });

                            // Handle rack selection change
                            $rackNoDropdown.off('change.quantity').on('change.quantity', function () {
                                const selectedRack = $(this).val();
                                updateAvailableQuantity(selectedWarehouseId, selectedRack);
                            });
                        } else {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Invalid Barcode or No Stock',
                                text: 'No product or stock found for this barcode.',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'OK'
                            });
                            resetForm();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong while fetching product details.',
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'OK'
                        });
                        resetForm();
                    }
                });
            }
        });

        // ProductName Input Autocomplete
        $productInput.on('input', function () {
            var term = $(this).val().trim();
            selectedIndex = -1;

            if (term.length < 1) {
                $productList.hide().empty();
                return;
            }

            $.ajax({
                url: '/Inventory/GetProductsForStockOut',
                type: 'GET',
                dataType: 'json',
                data: { term: term },
                success: function (data) {
                    $productList.empty();
                    if (data.length === 0) {
                        $productList.hide();
                        return;
                    }

                    $.each(data, function (index, item) {
                        $productList.append(
                            $('<li>').text(item.productName)
                                .attr('data-id', item.id)
                                .attr('data-barcodeNo', item.skuName)
                                .on('click', function () {
                                    $productInput.val(item.productName);
                                    $skuInput.val(item.skuName);
                                    $productId.val(item.id);
                                    $productList.hide().empty();
                                    $warehouseDropdown.trigger('change');
                                })
                        );
                    });

                    $productList.show();
                },
                error: function () {
                    $productList.hide().empty();
                }
            });
        });

        // Product input keyboard navigation
        $productInput.on('keydown', function (e) {
            var items = $productList.find('li');
            if ($productList.is(':visible')) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (selectedIndex < items.length - 1) {
                        selectedIndex++;
                        highlightItem(items, selectedIndex);
                    }
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (selectedIndex > 0) {
                        selectedIndex--;
                        highlightItem(items, selectedIndex);
                    }
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedIndex >= 0 && selectedIndex < items.length) {
                        var selected = $(items[selectedIndex]);
                        $productInput.val(selected.text());
                        $productId.val(selected.attr('data-id'));
                        $skuInput.val(selected.attr('data-barcodeNo'));
                        $productList.hide().empty();
                        $warehouseDropdown.trigger('change');
                    }
                }
            }
        });

        // Hide product list when clicking outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#product, #productList').length) {
                $productList.hide().empty();
            }
        });

        // Clear product ID and barcode if product input cleared
        $productInput.on('change', function () {
            if ($(this).val().trim() === '') {
                $productId.val('');
                $skuInput.val('');
                $availableQuantity.val('');
            }
        });

        // Add button logic
        $('#addButton').on('click', function (e) {
            e.preventDefault();
            autoAddToTable();
        });

        // Add row to table with rack validation
        function autoAddToTable() {
            const barcodeNo = $skuInput.val();
            const productId = $productId.val();
            const productText = $productInput.val();
            let rawQty = parseInt($productQuantity.val()) || 0;
            let productQuantityVal = productType == 1 ? rawQty * perBoxQty : rawQty;
            const reason = $('#reason option:selected').text();
            const warehouseId = $warehouseDropdown.val();
            const warehouseText = $warehouseDropdown.find('option:selected').text();
            const rackNo = $rackNoDropdown.val();
            const stockInQuantity = parseInt($availableQuantity.val()) || 0;
            const perBoxQtyDisplay = productType == 1 ? perBoxQty : '-';
            const racksAvailable = $rackNoDropdown.find('option').length > 1;

            // Validate required fields (excluding rackNo if no racks are available)
            if (!barcodeNo || !productId || !productQuantityVal || !reason || !warehouseId) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Fields',
                    text: 'Please fill all required fields.',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Validate available quantity
            if (stockInQuantity <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Stock Available',
                    text: `No available quantity for this barcode with type ${productType} in the selected warehouse.`,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Calculate total warehouse quantity for validation
            const totalWarehouseQty = warehouseQuantities
                .filter(q => q.warehouseId == parseInt(warehouseId) && q.type == productType)
                .reduce((sum, q) => sum + (q.totalQuantity || 0), 0);

            if (totalWarehouseQty <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Stock Available',
                    text: `No available quantity for this barcode with type ${productType} in the selected warehouse.`,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });
                return;
            }

            function proceedToAddOrUpdate() {
                // Proceed to add or update row
                const table = $('#stockOutTable tbody');
                let totalQtyForProductWarehouseRackType = 0;
                table.find('tr').each(function () {
                    const rowProductId = $(this).data('product-id');
                    const rowWarehouseId = $(this).data('warehouse-id');
                    const rowRackNo = $(this).data('rack-no') || '';
                    const rowType = $(this).data('type');
                    if (rowProductId == productId && rowWarehouseId == warehouseId && rowRackNo == (rackNo || '') && rowType == productType) {
                        const qtyVal = parseInt($(this).find('input.quantity-input').val()) || 0;
                        totalQtyForProductWarehouseRackType += qtyVal;
                    }
                });

                let existingRow = null;
                table.find('tr').each(function () {
                    const rowBarcode = $(this).find('td:eq(1)').text();
                    const rowProductId = $(this).data('product-id');
                    const rowWarehouseId = $(this).data('warehouse-id');
                    const rowReason = $(this).data('reason');
                    const rowRackNo = $(this).data('rack-no') || '';
                    const rowType = $(this).data('type');
                    if (rowBarcode === barcodeNo && rowProductId == productId && rowWarehouseId == warehouseId && rowReason === reason && rowRackNo == (rackNo || '') && rowType == productType) {
                        existingRow = $(this);
                        return false;
                    }
                });

                if (existingRow) {
                    const qtyCell = existingRow.find('td:eq(3)');
                    const scanCountCell = existingRow.find('td:eq(4)');

                    const currentQty = parseInt(qtyCell.find('input.quantity-input').val()) || 0;
                    const currentScanCount = parseInt(scanCountCell.text()) || 0;

                    let newScanCount = productType == 1 ? currentScanCount + 1 : currentScanCount;
                    let newQty = productType == 1
                        ? newScanCount * perBoxQty
                        : currentQty + productQuantityVal;

                    const newTotalQty = totalQtyForProductWarehouseRackType - currentQty + newQty;

                    if (newTotalQty > stockInQuantity) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Stock Limit Exceeded',
                            text: `Total quantity cannot exceed available stock of ${stockInQuantity} for ${rackNo ? 'rack ' + rackNo : 'warehouse'} with type ${productType}.`,
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }

                    // Update quantity input and scan count cell
                    qtyCell.find('input.quantity-input').val(newQty);
                    if (productType == 1) {
                        scanCountCell.text(newScanCount);
                    }
                } else {
                    let qtyToShow = productType == 1 ? 1 : productQuantityVal;

                    if ((totalQtyForProductWarehouseRackType + qtyToShow) > stockInQuantity) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Stock Limit Exceeded',
                            text: `Total quantity cannot exceed available stock of ${stockInQuantity} for ${rackNo ? 'rack ' + rackNo : 'warehouse'} with type ${productType}.`,
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }

                    const quantityInputHtml = `
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control quantity-input" value="${productQuantityVal}" data-original-qty="${rawQty}" min="1" style="width: 60px;"
                                    ${productType == 1 ? 'readonly' : ''}
                                    oninput="restrictAndValidateInput(this, ${stockInQuantity}, ${productId}, ${warehouseId}, ${productType})"
                                    onkeypress="return (event.charCode !=8 && event.charCode ==0 || (event.charCode >= 48 && event.charCode <= 57))">
                            </div>
                        </td>
                    `;

                    const newRow = `
                        <tr data-product-id="${productId}" data-reason="${reason}" data-warehouse-id="${warehouseId}" data-rack-no="${rackNo || ''}" data-type="${productType}">
                            <td>${serialNumber++}</td>
                            <td>${barcodeNo}</td>
                            <td>${productText}</td>
                            ${quantityInputHtml}
                            <td>${productType == 1 ? qtyToShow : '-'}</td>
                            <td>${perBoxQtyDisplay}</td>
                            <td>${reason}</td>
                            <td>${warehouseText}</td>
                            <td>${rackNo || '-'}</td>
                            <td><button type="button" class="btn btn-danger btn-sm removeRow">Remove</button></td>
                        </tr>
                    `;
                    table.append(newRow);
                }

                // Sync dropdowns with the added/updated row
                $warehouseDropdown.val(warehouseId).trigger('change');
                setTimeout(() => {
                    $rackNoDropdown.val(rackNo || '');
                    updateAvailableQuantity(warehouseId, rackNo);
                }, 100); // Small delay to ensure rack dropdown is populated

                // Reset form
                resetForm();
            }

            if (racksAvailable) {
                // Validate warehouse + rack + barcode + type combo exists
                $.ajax({
                    url: '/Inventory/CheckStockAvailability',
                    type: 'GET',
                    data: {
                        sku: barcodeNo,
                        warehouseId: warehouseId,
                        rackNo: rackNo
                    },
                    success: function (exists) {
                        if (!exists) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Invalid Rack or Warehouse',
                                text: `No stock found for this barcode with type ${productType} in selected warehouse and rack ${rackNo}.`,
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'OK'
                            });
                            return;
                        }
                        proceedToAddOrUpdate();
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to validate stock availability.',
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            } else {
                // For no racks available, rely on local warehouse quantity check
                if (totalWarehouseQty > 0) {
                    proceedToAddOrUpdate();
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Stock Available',
                        text: `No available quantity for this barcode with type ${productType} in the selected warehouse.`,
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'OK'
                    });
                }
            }
        }

        // Reset form fields
        function resetForm() {
            $skuInput.val('');
            $productInput.val('');
            $productId.val('');
            $availableQuantity.val('');
            $productQuantity.val('1');
            $skuInput.focus();
        }

        // Remove row handler
        $('#stockOutTable').on('click', '.removeRow', function () {
            $(this).closest('tr').remove();
            updateSerialNumbers();
            // Sync dropdowns with the last row, if any
            const lastRow = $('#stockOutTable tbody tr:last');
            if (lastRow.length) {
                const lastWarehouseId = lastRow.data('warehouse-id');
                const lastRackNo = lastRow.data('rack-no') || '';
                $warehouseDropdown.val(lastWarehouseId).trigger('change');
                setTimeout(() => {
                    $rackNoDropdown.val(lastRackNo);
                    updateAvailableQuantity(lastWarehouseId, lastRackNo);
                }, 100);
            } else {
                $warehouseDropdown.val('');
                $rackNoDropdown.empty().append('<option value="">Select Warehouse First</option>');
                $availableQuantity.val('0');
            }
        });

        // Update serial numbers
        function updateSerialNumbers() {
            const rows = $('#stockOutTable tbody tr');
            serialNumber = 1;
            rows.each(function () {
                $(this).find('td:first').text(serialNumber++);
            });
        }

        // Highlight autocomplete item
        function highlightItem(items, index) {
            items.removeClass('highlighted');
            $(items[index]).addClass('highlighted');
        }
    });
